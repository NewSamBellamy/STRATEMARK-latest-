{
  "name": "@mi/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=esm --target=node20 --external:electron --outdir=dist --out-extension:.js=.mjs",
    "build": "pnpm --filter @mi/web build && pnpm build:main",
    "dev": "pnpm build:main && electron .",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.marketintel.deckbuilder",
    "productName": "Market Intel Deck Builder",
    "files": ["dist/**"],
    "extraResources": [{ "from": "../web/dist", "to": "web-dist" }],
    "directories": { "output": "release" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Office" }
  },
  "dependencies": {
    "@mi/contracts": "workspace:*",
    "@mi/mocks": "workspace:*",
    "@mi/research": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
